FROM python:3.11-slim

# 国内镜像源加速（apt + pip）
RUN sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true

WORKDIR /app

# 系统依赖（含 Tesseract OCR + 中文语言包，用于扫描 PDF 文字识别）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-chi-tra \
    && rm -rf /var/lib/apt/lists/*

# 安装依赖并复制应用代码（含 worker 包，用于 Celery 任务分发）
COPY backend ./backend
COPY worker ./worker
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple ./backend ./worker

WORKDIR /app/backend

EXPOSE 8000

# 启动脚本：等待数据库 → 迁移 → 启动
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
