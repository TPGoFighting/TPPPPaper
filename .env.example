# 部署环境变量（复制为 .env 并修改）
# 生成密码哈希: docker run --rm tpaper-api python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('your-password'))"

POSTGRES_PASSWORD=change-me-postgres-pwd

# 至少 32 字符的随机字符串
MASTER_SECRET=change-me-in-production-32bytes!
SESSION_SECRET=change-me-session-secret-32bytes!

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# 开发环境留空则使用默认 admin/admin（仅 ENV=dev 生效）
ENV=prod
