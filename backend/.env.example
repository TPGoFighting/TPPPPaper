# TPaper 后端环境变量示例
# 生产环境必须替换所有 change-me 值

# 运行环境
ENV=prod
DEBUG=false

# 数据库
DATABASE_URL=postgresql+psycopg://tpaper:tpaper@postgres:5432/tpaper

# Redis
REDIS_URL=redis://redis:6379/0

# ── 安全（生产必须替换，至少 32 字符）──
MASTER_SECRET=change-me-in-production-32bytes!
SESSION_SECRET=change-me-session-secret-32bytes!

# 管理员账号
ADMIN_USERNAME=admin
# 生成方式: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=

# 存储卷
STORAGE_ROOT=/data/storage

# 上传限制
UPLOAD_MAX_SIZE_MB=50
UPLOAD_MAX_PAGES=200

# CORS
CORS_ORIGINS=["http://localhost:3000"]
